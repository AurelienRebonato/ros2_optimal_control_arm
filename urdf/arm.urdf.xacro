<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot_arm">
    <xacro:arg name="suffix" default="v1"/>  
    <xacro:property name="suffix" value="$(arg suffix)"/>
    <xacro:property name="link1_length" value="1"/>
    <xacro:property name="link2_length" value="1"/>
    <xacro:property name="link3_length" value="1" />

    <xacro:property name="link1_radius" value="0.1" />
    <xacro:property name="link2_radius" value="0.1" />
    <xacro:property name="link3_radius" value="0.1" />

    <xacro:property name="link1_mass" value="1.0"/>
    <xacro:property name="link2_mass" value="0.5"/>
    <xacro:property name="link3_mass" value="0.2"/>

    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="red"><color rgba="1 0 0 1"/></material>
    <material name="green"><color rgba="0 1 0 1"/></material>

    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0" 
                 iyy="${(m/12) * (3*r*r + h*h)}" iyz="0" 
                 izz="${(m/2) * (r*r)}" />
    </xacro:macro>

    
    <xacro:macro name="Arm3Joints" params="parent suffix *origin">

        <!-- === JOINT 1=== -->
        <joint name="joint1_${suffix}" type="revolute">
            <xacro:insert_block name="origin" /> 
            <parent link="${parent}"/>
            <child link="link1_${suffix}"/>
            <axis xyz="0 0 1"/>
            <limit lower="-3.14" upper="3.14" effort="3000.0" velocity="2.0"/>
            <dynamics damping="0.5" friction="0.00"/>
        </joint>

        <!-- === LINK 1 === -->
        <link name="link1_${suffix}">
            <visual>
                <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${link1_length}" radius="${link1_radius}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${link1_length}" radius="${link1_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
                <mass value="${link1_mass}"/>
                <xacro:cylinder_inertia m="${link1_mass}" r="${link1_radius}" h="${link1_length}"/>
            </inertial>
        </link>

        <!-- === JOINT 2 === -->
        <joint name="joint2_${suffix}" type="revolute">
            <origin xyz="0 0 ${link1_length}" rpy="0 0 0" />
            <parent link="link1_${suffix}"/>
            <child link="link2_${suffix}"/>
            <axis xyz="0 1 0"/>
            <limit lower="-3.0" upper="3.0" effort="3000.0" velocity="2.0"/>
            <dynamics damping="0.5" friction="0.00"/>
        </joint>

        <!-- === LINK 2 === -->
        <link name="link2_${suffix}">
            <visual>
                <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${link2_length}" radius="${link2_radius}"/>
                </geometry>
                <material name="red"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${link2_length}" radius="${link2_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
                <mass value="${link2_mass}"/>
                <xacro:cylinder_inertia m="${link2_mass}" r="${link2_radius}" h="${link2_length}"/>
            </inertial>
        </link>

        <!-- === JOINT 3 === -->
        <joint name="joint3_${suffix}" type="revolute">
            <origin xyz="0 0 ${link2_length}" rpy="0 0 0" />
            <parent link="link2_${suffix}"/>
            <child link="link3_${suffix}"/>
            <axis xyz="1 0 0"/>
            <limit lower="-3.0" upper="3.0" effort="3000.0" velocity="2.0"/>
            <dynamics damping="0.5" friction="0.00"/>
        </joint>

        <!-- === LINK 3 === -->
        <link name="link3_${suffix}">
            <visual>
                <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${link3_length}" radius="${link3_radius}"/>
                </geometry>
                <material name="green"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${link3_length}" radius="${link3_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
                <mass value="${link3_mass}"/>
                <xacro:cylinder_inertia m="${link3_mass}" r="${link3_radius}" h="${link3_length}"/>
            </inertial>
        </link>

    </xacro:macro>

    <link name="world"/>

    <xacro:Arm3Joints parent="world" suffix="v1">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:Arm3Joints>

    <ros2_control name="GazeboSystem" type="system">

        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="joint1_${suffix}">
            <command_interface name="effort"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="joint2_${suffix}">
            <command_interface name="effort"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="joint3_${suffix}">
            <command_interface name="effort"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find robot_arm_pkg)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>